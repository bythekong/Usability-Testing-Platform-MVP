datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  TESTER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tester Profile fields
  age            Int?
  gender         String?
  occupation     String?
  itExpertise    String?

  ownedCampaigns TestCampaign[]  @relation("CampaignOwner")
  jobAssignments JobAssignment[] @relation("JobTester")
}

enum PaymentStatus {
  PENDING
  FUNDED
  COMPLETED
}

model TestCampaign {
  id              String        @id @default(uuid())
  ownerId         String
  targetUrl       String
  rewardAmount    Int
  currency        String        @default("USD")
  testerCount     Int           @default(1)
  scenario        String?       @db.Text
  paymentStatus   PaymentStatus @default(PENDING)
  stripePaymentId String?
  isLocked        Boolean       @default(false)

  // Targeting fields
  targetMinAge       Int?
  targetMaxAge       Int?
  targetGenders      String[]
  targetItExpertises String[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner User @relation("CampaignOwner", fields: [ownerId], references: [id])
  tasks Task[]
  jobs  JobAssignment[]
}

model Task {
  id           String   @id @default(uuid())
  campaignId   String
  stepOrder    Int
  instruction  String
  maxTimeLimit Int      @default(300)
  taskType     String   @default("FREE_RESPONSE")

  // MULTIPLE_CHOICE fields
  choices      String[]

  // RATING_SCALE fields
  ratingMin      Int?
  ratingMax      Int?
  ratingMinLabel String?
  ratingMaxLabel String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign  TestCampaign @relation(fields: [campaignId], references: [id])
  responses TaskResponse[]

  @@unique([campaignId, stepOrder])
}

enum JobStatus {
  AVAILABLE
  CLAIMED
  SUBMITTED
  APPROVED
  REJECTED
}

model JobAssignment {
  id            String    @id @default(uuid())
  campaignId    String
  testerId      String?
  status        JobStatus @default(AVAILABLE)
  videoUrl      String?
  videoMetadata Json?
  claimedAt     DateTime?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaign  TestCampaign  @relation(fields: [campaignId], references: [id])
  tester    User?         @relation("JobTester", fields: [testerId], references: [id])
  responses TaskResponse[]
}

model TaskResponse {
  id               String    @id @default(uuid())
  jobId            String
  taskId           String
  answerText       String?   @db.Text
  videoUrl         String?
  // Stores locked in-session answer for MULTIPLE_CHOICE and RATING_SCALE tasks.
  // Set once via the extension during recording; never overwritten afterwards.
  structuredAnswer Json?
  structuredAnswerLockedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job  JobAssignment @relation(fields: [jobId], references: [id])
  task Task          @relation(fields: [taskId], references: [id])

  @@unique([jobId, taskId])
}

