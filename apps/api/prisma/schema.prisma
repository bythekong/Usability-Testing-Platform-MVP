datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  TESTER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCampaigns TestCampaign[]  @relation("CampaignOwner")
  jobAssignments JobAssignment[] @relation("JobTester")
}

enum PaymentStatus {
  PENDING
  FUNDED
  COMPLETED
}

model TestCampaign {
  id              String        @id @default(uuid())
  ownerId         String
  targetUrl       String
  rewardAmount    Int
  currency        String        @default("USD")
  paymentStatus   PaymentStatus @default(PENDING)
  stripePaymentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner User @relation("CampaignOwner", fields: [ownerId], references: [id])
  tasks Task[]
  jobs  JobAssignment[]
}

model Task {
  id          String   @id @default(uuid())
  campaignId  String
  stepOrder   Int
  instruction String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  TestCampaign @relation(fields: [campaignId], references: [id])
  responses TaskResponse[]

  @@unique([campaignId, stepOrder])
}

enum JobStatus {
  AVAILABLE
  CLAIMED
  SUBMITTED
  APPROVED
  REJECTED
}

model JobAssignment {
  id            String    @id @default(uuid())
  campaignId    String
  testerId      String?
  status        JobStatus @default(AVAILABLE)
  videoUrl      String?
  videoMetadata Json?
  claimedAt     DateTime?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaign  TestCampaign  @relation(fields: [campaignId], references: [id])
  tester    User?         @relation("JobTester", fields: [testerId], references: [id])
  responses TaskResponse[]
}

model TaskResponse {
  id         String   @id @default(uuid())
  jobId      String
  taskId     String
  answerText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job  JobAssignment @relation(fields: [jobId], references: [id])
  task Task          @relation(fields: [taskId], references: [id])

  @@unique([jobId, taskId])
}
